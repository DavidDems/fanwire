+describe("AuthProvider asynchronous sign-out", () => {
+  it.each([false, true])(
+    "waits for sign-out and retains the session when it fails: %s",
+    async (fails) => {
+      const service = new FakeAuthService({ session: testSession() });
+      let release!: () => void;
+      let reject!: (error: Error) => void;
+      const gate = new Promise<void>((resolve, fail) => {
+        release = resolve;
+        reject = fail;
+      });
+      // The service promise is handled even against the old void context.
+      void gate.catch(() => {});
+      const signOut = vi.spyOn(service, "signOut").mockImplementation(() => gate);
+      let context: ReturnType<typeof useAuth> | undefined;
+      function SessionProbe() {
+        context = useAuth();
+        return (
+          <>
+            <p>status: {context.status}</p>
+            <p>email: {context.session?.email ?? "nobody"}</p>
+          </>
+        );
+      }
+      renderWithAuth(<SessionProbe />, { authService: service });
+      await screen.findByText("status: authenticated");
+      const failure = new Error("Sign-out did not complete");
+      let result: unknown;
+      let outcome: Promise<unknown> = Promise.resolve();
+      try {
+        act(() => {
+          result = context!.signOut();
+          // Attach immediately: failed provider promises must also be handled.
+          outcome = Promise.resolve(result).catch((error: unknown) => error);
+        });
+        expect(signOut).toHaveBeenCalledTimes(1);
+        expect(result).toBeInstanceOf(Promise);
+        expect(screen.queryByText("status: anonymous")).toBeNull();
+        expect(screen.getByText(`email: ${TEST_EMAIL}`)).toBeInTheDocument();
+        await act(async () => {
+          if (fails) reject(failure);
+          else release();
+          await outcome;
+        });
+        if (fails) {
+          expect(await outcome).toBe(failure);
+          expect(screen.queryByText("status: anonymous")).toBeNull();
+          expect(screen.getByText(`email: ${TEST_EMAIL}`)).toBeInTheDocument();
+        } else {
+          expect(screen.getByText("status: anonymous")).toBeInTheDocument();
+          expect(screen.getByText("email: nobody")).toBeInTheDocument();
+        }
+      } finally {
+        await act(async () => {
+          release();
+          await outcome;
+        });
+      }
+    },
+  );
+});
