+"""AUTH-001 durable barriers must work on Alembic's schema, not just metadata."""
+
+from pathlib import Path
+
+from alembic.config import Config
+
+from alembic import command
+from app.db import make_engine, make_session_factory
+from app.users import recovery
+
+
+def test_migrated_schema_persists_profileless_pending_and_committed_cutoffs(
+    postgres_url, monkeypatch
+):
+    monkeypatch.setenv("DATABASE_URL", postgres_url)
+    config = Config(str(Path(__file__).resolve().parents[2] / "alembic.ini"))
+    command.upgrade(config, "head")
+    engine = make_engine(postgres_url)
+    factory = make_session_factory(engine)
+    try:
+        with factory() as session:
+            attempt = recovery.RecoveryRepository(session).begin_pending("no-profile", 100)
+        with factory() as session:
+            repo = recovery.RecoveryRepository(session)
+            assert repo.cutoff_for("no-profile") == 100
+            repo.commit_pending("no-profile", attempt)
+        with factory() as session:
+            assert recovery.RecoveryRepository(session).cutoff_for("no-profile") == 100
+    finally:
+        engine.dispose()
+        command.downgrade(config, "base")
