+++ b/backend/app/users/recovery.py
@@ -0,0 +1,153 @@
+"""Durable reset barriers and serialized rolling-hour recovery limits.
+
+Cutoffs reserve 60 seconds plus upward rounding before confirmation starts.
+The deployed API Lambda has a hard 25-second execution limit; Cognito calls
+also use bounded connect/read timeouts without retries. The reserve covers
+the entire remaining invocation, including an ambiguous confirmation or failed
+barrier commit, and one-second Cognito auth_time precision. An old-password
+login during confirmation therefore cannot outlive the barrier. A normal
+sign-in must be strictly later than the stored cutoff (up to 62 seconds' wait).
+This bound assumes the deployed 25-second Lambda limit; any execution host
+with a longer lifetime must enforce a shorter confirmation deadline or increase
+the reserve before serving recovery traffic. Interrupted pending rows remain
+active but do not prevent normal sign-in after their finite cutoff.
+"""
+
+from datetime import UTC, datetime
+from math import ceil
+from typing import Any
+
+from botocore.exceptions import BotoCoreError, ClientError  # type: ignore[import-untyped]
+from fastapi import HTTPException
+from sqlalchemy import delete, func, select
+from sqlalchemy.dialects.postgresql import insert
+from sqlalchemy.exc import SQLAlchemyError
+from sqlalchemy.orm import Session
+
+from app.settings import Settings
+from app.users.models import RecoveryBarrier, RecoveryLimit
+
+
+class RecoveryRepository:
+    def __init__(self, session: Session) -> None:
+        self.session = session
+
+    def begin_pending(self, sub: str, cutoff: int) -> int:
+        row = RecoveryBarrier(subject=sub, cutoff=cutoff)
+        self.session.add(row)
+        self.session.flush()
+        attempt = row.id
+        self.session.commit()
+        return attempt
+
+    def commit_pending(self, sub: str, attempt: int) -> None:
+        # Retaining each committed barrier avoids a concurrent cleanup ever
+        # moving the effective maximum backwards. No credential is stored.
+        row = self.session.scalar(
+            select(RecoveryBarrier)
+            .where(RecoveryBarrier.subject == sub, RecoveryBarrier.id == attempt)
+            .with_for_update()
+        )
+        if row is None:
+            raise RuntimeError("Missing recovery barrier")
+        row.committed = True
+        self.session.commit()
+
+    def discard_pending(self, sub: str, attempt: int) -> None:
+        self.session.execute(
+            delete(RecoveryBarrier).where(
+                RecoveryBarrier.subject == sub,
+                RecoveryBarrier.id == attempt,
+                RecoveryBarrier.committed.is_(False),
+            )
+        )
+        self.session.commit()
+
+    def cutoff_for(self, sub: str) -> int | None:
+        return self.session.scalar(
+            select(func.max(RecoveryBarrier.cutoff)).where(RecoveryBarrier.subject == sub)
+        )
+
+    def rate_limit(self, email: str, ip: str) -> None:
+        now = datetime.now(UTC).timestamp()
+        # A consistent key order prevents deadlocks across overlapping keys.
+        rows: list[RecoveryLimit] = []
+        for key in sorted(("email:" + email, "ip:" + ip)):
+            self.session.execute(
+                insert(RecoveryLimit)
+                .values(key=key, attempts=[])
+                .on_conflict_do_nothing(index_elements=["key"])
+            )
+            row = self.session.scalar(
+                select(RecoveryLimit).where(RecoveryLimit.key == key).with_for_update()
+            )
+            if row is None:
+                raise RuntimeError("Missing recovery rate limit")
+            row.attempts = [t for t in row.attempts if t > now - 3600]
+            rows.append(row)
+        if any(len(row.attempts) >= 5 for row in rows):
+            self.session.rollback()
+            raise HTTPException(429, "Too many recovery attempts. Try again later.")
+        for row in rows:
+            row.attempts = [*row.attempts, now]
+        self.session.commit()
+
+
+def _recovery_subject(client: Any, settings: Settings, email: str) -> str | None:
+    try:
+        user = client.admin_get_user(UserPoolId=settings.cognito_user_pool_id, Username=email)
+    except ClientError as exc:
+        if exc.response["Error"]["Code"] == "UserNotFoundException":
+            return None
+        raise
+    attributes = {a["Name"]: a["Value"] for a in user.get("UserAttributes", [])}
+    if not user.get("Enabled") or attributes.get("email_verified") != "true":
+        return None
+    return attributes.get("sub")
+
+
+def request_password_reset(
+    email: str, ip: str, session: Session, settings: Settings, client: Any
+) -> dict[str, str]:
+    try:
+        RecoveryRepository(session).rate_limit(email, ip)
+        sub = _recovery_subject(client, settings, email)
+        if sub:
+            client.forgot_password(ClientId=settings.cognito_app_client_id, Username=email)
+    except (ClientError, BotoCoreError, TimeoutError):
+        # Cognito delivery and eligibility details must never escape this endpoint.
+        return {"message": "If the account is eligible, a recovery code will be sent."}
+    except SQLAlchemyError as exc:
+        raise HTTPException(503, "Recovery unavailable") from exc
+    return {"message": "If the account is eligible, a recovery code will be sent."}
+
+
+def confirm_password_reset(
+    email: str, code: str, password: str, ip: str, session: Session, settings: Settings, client: Any
+) -> dict[str, str]:
+    repo = RecoveryRepository(session)
+    try:
+        repo.rate_limit(email, ip)
+        sub = _recovery_subject(client, settings, email)
+        if not sub:
+            raise HTTPException(400, "Unable to reset password. Check the code and try again.")
+        attempt = repo.begin_pending(sub, ceil(datetime.now(UTC).timestamp()) + 60)
+        try:
+            client.confirm_forgot_password(
+                ClientId=settings.cognito_app_client_id,
+                Username=email,
+                ConfirmationCode=code,
+                Password=password,
+            )
+        except ClientError as exc:
+            if exc.response["Error"]["Code"] in ("CodeMismatchException", "ExpiredCodeException"):
+                repo.discard_pending(sub, attempt)
+                raise HTTPException(
+                    400, "Unable to reset password. Check the code and try again."
+                ) from exc
+            raise
+        repo.commit_pending(sub, attempt)
+        client.admin_user_global_sign_out(UserPoolId=settings.cognito_user_pool_id, Username=sub)
+    except (ClientError, BotoCoreError, TimeoutError, SQLAlchemyError) as exc:
+        raise HTTPException(503, "Unable to complete password reset. Please try again.") from exc
+    return {"message": "Password reset complete. Please sign in again."}
