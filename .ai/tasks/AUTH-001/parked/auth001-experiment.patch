@@ -0,0 +1,433 @@
+"""AUTH-001: native Cognito recovery with a durable subject session barrier.
+
+Repository seam: begin_pending(sub, cutoff) returns an opaque attempt handle;
+commit_pending/discard_pending take (sub, handle), cutoff_for(sub) returns the
+maximum pending/committed integer cutoff. Each mutation commits independently.
+"""
+
+from concurrent.futures import ThreadPoolExecutor
+from datetime import UTC, datetime
+from math import ceil
+
+import pytest
+from botocore.exceptions import ClientError
+from fastapi import Depends, FastAPI
+from fastapi.testclient import TestClient
+from freezegun import freeze_time
+from sqlalchemy.exc import SQLAlchemyError
+
+from app.db import Base, make_engine, make_session_factory
+from app.dependencies import get_session, get_settings
+from app.settings import Settings
+from app.users import recovery
+from app.users.auth import FakeTokenVerifier, VerifiedIdentity
+from app.users.dependencies import (
+    get_cognito_client,
+    get_current_identity,
+    get_optional_current_user,
+    get_token_verifier,
+)
+from app.users.routes import router
+
+REQUEST = "/users/password-reset/request"
+CONFIRM = "/users/password-reset/confirm"
+EMAIL = "verified@example.com"
+SUB = "subject-without-local-profile"
+PASSWORD = "New-password-123!"
+BODY = {"email": EMAIL, "code": "123456", "new_password": PASSWORD,
+        "confirm_password": PASSWORD}
+NOW = "2026-11-07T15:00:00.250000+00:00"
+
+
+@pytest.fixture()
+def factory(postgres_url):
+    engine = make_engine(postgres_url)
+    Base.metadata.create_all(engine)
+    yield make_session_factory(engine)
+    Base.metadata.drop_all(engine)
+    engine.dispose()
+
+
+class Cognito:
+    """Only approved recovery operations exist; an attribute write fails loudly."""
+
+    def __init__(self, factory):
+        self.factory = factory
+        self.calls = []
+        self.kind = "verified"
+        self.error = None
+        self.signout_error = False
+        self.at_confirm = None
+
+    def admin_get_user(self, **kwargs):
+        self.calls.append(("lookup", kwargs))
+        if self.kind == "unknown":
+            raise ClientError({"Error": {"Code": "UserNotFoundException"}}, "AdminGetUser")
+        return {"Username": SUB, "Enabled": self.kind != "disabled",
+                "UserAttributes": [{"Name": "sub", "Value": SUB},
+                                   {"Name": "email", "Value": EMAIL},
+                                   {"Name": "email_verified", "Value":
+                                    "false" if self.kind == "unverified" else "true"}]}
+
+    def forgot_password(self, **kwargs):
+        self.calls.append(("forgot", kwargs))
+        return {"CodeDeliveryDetails": {"Destination": "v***@example.com"}}
+
+    def confirm_forgot_password(self, **kwargs):
+        self.calls.append(("confirm", kwargs))
+        # A different connection must observe the pending cutoff BEFORE Cognito.
+        with self.factory() as session:
+            assert recovery.RecoveryRepository(session).cutoff_for(SUB) is not None
+        if self.at_confirm:
+            self.at_confirm()
+        if self.error:
+            raise self.error
+        return {}
+
+    def admin_user_global_sign_out(self, **kwargs):
+        self.calls.append(("signout", kwargs))
+        return {} if not self.signout_error else self._fail_signout()
+
+    def _fail_signout(self):
+        raise TimeoutError("global sign-out unavailable")
+
+
+def client_for(factory, cognito, auth_time=0, source_ip="192.0.2.1"):
+    application = FastAPI()
+    application.include_router(router)
+
+    @application.middleware("http")
+    async def source_address(request, call_next):
+        request.scope["client"] = (source_ip, 12345)
+        return await call_next(request)
+
+    @application.get("/identity")
+    def identity(value: VerifiedIdentity = Depends(get_current_identity)):
+        return {"sub": value.sub}
+
+    @application.get("/optional")
+    def optional(value=Depends(get_optional_current_user)):
+        return {"present": value is not None}
+
+    def sessions():
+        with factory() as session:
+            yield session
+
+    application.dependency_overrides[get_session] = sessions
+    application.dependency_overrides[get_cognito_client] = lambda: cognito
+    application.dependency_overrides[get_settings] = lambda: Settings(
+        database_url="postgresql+psycopg://unused:unused@localhost/unused",
+        cognito_region="ca-central-1", cognito_user_pool_id="ca-central-1_test",
+        cognito_app_client_id="test-client",
+    )
+    application.dependency_overrides[get_token_verifier] = lambda: FakeTokenVerifier(
+        VerifiedIdentity(sub=SUB, email=EMAIL, auth_time=auth_time)
+    )
+    return TestClient(application, raise_server_exceptions=False)
+
+
+def cutoff(factory):
+    with factory() as session:
+        return recovery.RecoveryRepository(session).cutoff_for(SUB)
+
+
+def test_request_equivalence_and_verified_delivery_only(factory):
+    cognito = Cognito(factory)
+    client = client_for(factory, cognito)
+    responses = []
+    for kind in ("verified", "unknown", "disabled", "unverified"):
+        cognito.kind = kind
+        cognito.calls.clear()
+        response = client.post(REQUEST, json={"email": EMAIL})
+        responses.append((response.status_code, response.json()))
+        assert [name for name, _ in cognito.calls] == (
+            ["lookup", "forgot"] if kind == "verified" else ["lookup"]
+        )
+    assert len({(status, str(body)) for status, body in responses}) == 1
+    assert 200 <= responses[0][0] < 300
+    assert "Destination" not in str(responses)
+    assert EMAIL not in str(responses)
+
