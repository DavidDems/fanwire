+import type { UnitBudget } from "../bundle-budget";
+
+/**
+ * USERS-005 replaces avatar presets with two palette selections. The shared
+ * Avatar and shell/feed/search rendering move in the entry; profile controls
+ * and their responsive styles move in the lazy profile output.
+ * Growth ceilings follow the task's 1 KiB gzip entry cap and keep each changed
+ * lazy output below the 500,000-byte raw hard limit.
+ */
+export default {
+  unit: "USERS-005",
+  entryJsGzipGrowth: 1_000,
+  entryJsRawGrowth: 2_000,
+  entryCssGzipGrowth: 1_000,
+  changed: {
+    ProfilePage: 5_000,
+    "css:ProfilePage.css": 1_800,
+  },
+} satisfies UnitBudget;
