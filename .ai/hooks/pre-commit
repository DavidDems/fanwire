#!/usr/bin/env bash
# Lint/format gate, run before a commit is made.
#
# Purpose in the agent system: stop a lint failure from consuming a CI run and
# an implementation attempt. A code agent that burns attempt 2 of 3 on a ruff
# finding has learned nothing and cost a full pipeline.
#
# Install (once, per clone - git does not install hooks from a tracked file):
#   git config core.hooksPath .ai/hooks
#
# This hook only checks what is STAGED, and only for languages whose tooling is
# actually present. A missing toolchain skips its check rather than blocking
# the commit: a hook that fires spuriously is a hook people disable.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only --diff-filter=ACM)"
[ -z "$STAGED" ] && exit 0

status=0

note() { printf '  %s\n' "$1" >&2; }
fail() { printf '\npre-commit: %s\n' "$1" >&2; status=1; }

# --- Python: backend/ and .ai/ ------------------------------------------------
PY_FILES="$(echo "$STAGED" | grep -E '\.py$' || true)"
if [ -n "$PY_FILES" ]; then
  RUFF=""
  if [ -x "$REPO_ROOT/backend/.venv/Scripts/ruff.exe" ]; then
    RUFF="$REPO_ROOT/backend/.venv/Scripts/ruff.exe"
  elif [ -x "$REPO_ROOT/backend/.venv/bin/ruff" ]; then
    RUFF="$REPO_ROOT/backend/.venv/bin/ruff"
  elif command -v ruff >/dev/null 2>&1; then
    RUFF="ruff"
  fi

  if [ -n "$RUFF" ]; then
    # shellcheck disable=SC2086
    if ! "$RUFF" check $PY_FILES; then
      fail "ruff found lint problems in staged Python."
      note "Fix them, or run: $RUFF check --fix <files>"
      note "Do not commit with --no-verify."
    fi
    # shellcheck disable=SC2086
    if ! "$RUFF" format --check $PY_FILES >/dev/null 2>&1; then
      fail "staged Python is not formatted."
      note "Run: $RUFF format <files>"
    fi
  else
    note "pre-commit: ruff not found, skipping Python lint"
  fi
fi

# --- The agent system's own suite --------------------------------------------
# Fast (sub-second, stdlib only) and it guards the state machine and the
# permission model, so it is worth running on every commit that touches it.
if echo "$STAGED" | grep -qE '^\.ai/(agentlib|tests|bin)/'; then
  if command -v python >/dev/null 2>&1; then
    if ! (cd "$REPO_ROOT/.ai" && python -m pytest -q >/dev/null 2>&1); then
      fail "the agent infrastructure suite fails."
      note "Run: cd .ai && python -m pytest"
    fi
    if ! python "$REPO_ROOT/.ai/bin/agentctl.py" selfcheck >/dev/null; then
      fail "agentctl selfcheck fails."
      note "Run: python .ai/bin/agentctl.py selfcheck"
    fi
  fi
fi

# --- Frontend -----------------------------------------------------------------
TS_FILES="$(echo "$STAGED" | grep -E '^frontend/.*\.(ts|tsx)$' || true)"
if [ -n "$TS_FILES" ] && [ -d "$REPO_ROOT/frontend/node_modules" ]; then
  if ! (cd "$REPO_ROOT/frontend" && npm run --silent lint >/dev/null 2>&1); then
    fail "eslint found problems in frontend/."
    note "Run: cd frontend && npm run lint"
  fi
fi

exit $status
